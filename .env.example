# SPX Signal Desk — Environment Variables
# Copy to .env.local for development

# ─── Database ────────────────────────────────────────────────────────────────
# Neon, Supabase, or any Postgres
DATABASE_URL=postgresql://user:password@host:5432/spx_signal_desk

# ─── Market Data APIs ────────────────────────────────────────────────────────
# Alpaca Markets — Primary for US stock/ETF quotes and intraday bars
# Paper trading key works for all data endpoints (iex feed)
# https://app.alpaca.markets/paper-trading → API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# MarketData.app — Primary for options data, quotes, and indices
# https://dashboard.marketdata.app/
MARKETDATA_API_KEY=
# Yahoo options are disabled by default because the endpoint often returns 401/429 from server runtimes.
# Set true only for local/experimental use; production should prefer MARKETDATA_API_KEY or another licensed options provider.
ENABLE_YAHOO_OPTIONS=false

# Alpha Vantage — Fallback for quotes (free tier available)
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — Free quote/news backup
# https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Polygon.io — Alternative data source
# https://polygon.io/
POLYGON_API_KEY=

# ─── News & Intelligence ─────────────────────────────────────────────────────
# GNews — Primary financial headlines (free: 100 req/day, 10 articles/req)
# https://gnews.io/
GNEWS_API_KEY=

# NewsAPI — Secondary financial headlines
# https://newsapi.org/register
NEWS_API_KEY=

# ─── AI Briefing ─────────────────────────────────────────────────────────────
# Anthropic (Claude) — Preferred
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — Fallback
OPENAI_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
# Twilio — SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=+15551234567

# SendGrid — Email alerts
SENDGRID_API_KEY=

# Alert recipients (worker notifications)
ALERT_PHONE=+15551234567
ALERT_EMAIL=trader@example.com

# ─── Authentication ──────────────────────────────────────────────────────────
# Static secret for API access. Set a long random string.
# APIs require: Authorization: Bearer <secret>  (or ?api_key=<secret>)
# Leave unset to allow all requests (development only).
API_SECRET=

# ─── Growth & Momentum Screener ──────────────────────────────────────────────
# Financial Modeling Prep — bulk fundamentals, Piotroski, DCF, congressional trades, ESG
# Free tier: 250 req/day (bulk-first strategy keeps daily usage ~8 calls for 300 tickers)
# https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Unusual Whales — Optional premium options flow & dark pool data
# https://unusualwhales.com/api ($50/mo)
UNUSUAL_WHALES_API_KEY=

# ─── Cache ───────────────────────────────────────────────────────────────────
# Redis (optional — for production caching)
REDIS_URL=redis://localhost:6379
