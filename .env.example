# SPX Signal Desk — Environment Variables
# Copy to .env.local for development

# ─── Database ────────────────────────────────────────────────────────────────
# Neon, Supabase, or any Postgres
DATABASE_URL=postgresql://user:password@host:5432/spx_signal_desk

# ─── Market Data APIs ────────────────────────────────────────────────────────
# MarketData.app — Primary for options data, quotes, and indices
# https://dashboard.marketdata.app/
MARKETDATA_API_KEY=

# Alpha Vantage — Fallback for quotes (free tier available)
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Polygon.io — Alternative data source
# https://polygon.io/
POLYGON_API_KEY=

# ─── News & Intelligence ─────────────────────────────────────────────────────
# NewsAPI — Financial headlines
# https://newsapi.org/register
NEWS_API_KEY=

# ─── AI Briefing ─────────────────────────────────────────────────────────────
# Anthropic (Claude) — Preferred
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — Fallback
OPENAI_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
# Twilio — SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=+15551234567

# SendGrid — Email alerts
SENDGRID_API_KEY=

# ─── Cache ───────────────────────────────────────────────────────────────────
# Redis (optional — for production caching)
REDIS_URL=redis://localhost:6379
